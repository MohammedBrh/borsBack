# Server
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Oanor Casablanca Stock Exchange API (free plan: 7,900 calls/month, 2 req/s)
OANOR_API_KEY=
OANOR_BASE_URL=https://api.oanor.com/casablanca-stock-api
OANOR_TIMEOUT_MS=8000
# Minimum spacing between upstream calls (free plan = 2 req/s -> 600 ms keeps a margin)
OANOR_MIN_INTERVAL_MS=600
# Safety stop before the monthly hard cap is hit
OANOR_MONTHLY_BUDGET=7500

# Cache TTLs (seconds). Session = BVC trading hours; closed = nights/weekends.
CACHE_TTL_SESSION_S=300
CACHE_TTL_CLOSED_S=3600

# Where the app stores the daily bars it records itself (for support/resistance history)
HISTORY_FILE=./data/history.json
